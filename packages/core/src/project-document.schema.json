{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarchitect.dev/schemas/project-document/1.0.0",
  "title": "Smarchitect Project Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "units",
    "activeLevelId",
    "levels",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "units": {
      "const": "metric"
    },
    "activeLevelId": {
      "type": "string",
      "pattern": "^level_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "baseElevationMm",
        "defaultWallHeightMm",
        "walls",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^level_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "baseElevationMm": {
          "type": "integer"
        },
        "defaultWallHeightMm": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wall"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "thicknessMm", "heightMm", "extensions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^wall_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "straight" },
            "start": { "$ref": "#/$defs/point" },
            "end": { "$ref": "#/$defs/point" }
          }
        },
        "thicknessMm": { "type": "integer", "exclusiveMinimum": 0 },
        "heightMm": { "type": "integer", "exclusiveMinimum": 0 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
      },
      "additionalProperties": true
    }
  }
}
