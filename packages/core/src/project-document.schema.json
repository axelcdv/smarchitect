{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarchitect.dev/schemas/project-document/1.0.0",
  "title": "Smarchitect Project Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "units",
    "activeLevelId",
    "levels",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "units": {
      "const": "metric"
    },
    "activeLevelId": {
      "type": "string",
      "pattern": "^level_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "baseElevationMm",
        "defaultWallHeightMm",
        "walls",
        "openings",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^level_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "baseElevationMm": {
          "type": "integer"
        },
        "defaultWallHeightMm": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wall"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "thicknessMm", "heightMm", "extensions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^wall_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "straight" },
            "start": { "$ref": "#/$defs/point" },
            "end": { "$ref": "#/$defs/point" }
          }
        },
        "thicknessMm": { "type": "integer", "exclusiveMinimum": 0 },
        "heightMm": { "type": "integer", "exclusiveMinimum": 0 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "opening": {
      "oneOf": [
        { "$ref": "#/$defs/door" },
        { "$ref": "#/$defs/window" },
        { "$ref": "#/$defs/passage" }
      ]
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "hostWallId", "positionMm", "widthMm", "heightMm",
        "operation", "extensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/openingId" },
        "kind": { "const": "door" },
        "hostWallId": { "$ref": "#/$defs/wallId" },
        "positionMm": { "type": "integer", "minimum": 0 },
        "widthMm": { "$ref": "#/$defs/positiveDimension" },
        "heightMm": { "$ref": "#/$defs/positiveDimension" },
        "operation": {
          "oneOf": [
            { "$ref": "#/$defs/hingedOperation" },
            { "$ref": "#/$defs/slidingOperation" }
          ]
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "hostWallId", "positionMm", "widthMm", "heightMm",
        "sillHeightMm", "operation", "extensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/openingId" },
        "kind": { "const": "window" },
        "hostWallId": { "$ref": "#/$defs/wallId" },
        "positionMm": { "type": "integer", "minimum": 0 },
        "widthMm": { "$ref": "#/$defs/positiveDimension" },
        "heightMm": { "$ref": "#/$defs/positiveDimension" },
        "sillHeightMm": { "type": "integer", "minimum": 0 },
        "operation": {
          "oneOf": [
            { "$ref": "#/$defs/fixedOperation" },
            { "$ref": "#/$defs/hingedOperation" },
            { "$ref": "#/$defs/slidingOperation" }
          ]
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "hostWallId", "positionMm", "widthMm", "heightMm",
        "extensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/openingId" },
        "kind": { "const": "passage" },
        "hostWallId": { "$ref": "#/$defs/wallId" },
        "positionMm": { "type": "integer", "minimum": 0 },
        "widthMm": { "$ref": "#/$defs/positiveDimension" },
        "heightMm": { "$ref": "#/$defs/positiveDimension" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "openingId": {
      "type": "string",
      "pattern": "^opening_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "wallId": {
      "type": "string",
      "pattern": "^wall_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "positiveDimension": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "pathDirection": {
      "enum": ["start", "end"]
    },
    "fixedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "fixed" }
      }
    },
    "hingedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "hingeSide", "swingDirection"],
      "properties": {
        "kind": { "const": "hinged" },
        "hingeSide": { "$ref": "#/$defs/pathDirection" },
        "swingDirection": { "enum": ["inward", "outward"] }
      }
    },
    "slidingOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slideDirection"],
      "properties": {
        "kind": { "const": "sliding" },
        "slideDirection": { "$ref": "#/$defs/pathDirection" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
      },
      "additionalProperties": true
    }
  }
}
